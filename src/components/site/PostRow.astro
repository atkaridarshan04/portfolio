---
/* One field note in a list: the ledger grammar the certifications and
   the stack use. Numeral, title and deck, then the log line of date,
   length and tags. */
import { formatDate, readingTime, tagSlug, type Post } from "@/lib/posts";

interface Props {
  post: Post;
  index: number;
}
const { post, index } = Astro.props;
const { title, deck, date, tags, draft } = post.data;
const minutes = readingTime(post.body);
---

<li class="border-b border-hairline">
  <a href={`/writing/${post.id}/`} class="group grid grid-cols-[2rem_1fr] gap-x-4 gap-y-2 rounded-lg px-3 py-6 transition-state hover:bg-surface/40 md:grid-cols-[2rem_1fr_auto] md:items-baseline">
    <span class="font-mono text-[11px] text-primary/70">{String(index + 1).padStart(2, "0")}</span>
    <div class="min-w-0">
      <h3 class="heading-sans text-[clamp(1.1rem,1.9vw,1.35rem)] leading-snug text-foreground transition-state group-hover:text-primary">
        {title}{draft && <span class="ml-2 align-middle chip">draft</span>}
      </h3>
      {deck && <p class="mt-1.5 text-[14px] leading-relaxed text-muted-foreground">{deck}</p>}
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="chip" data-tag={tagSlug(t)}>{t}</span>)}
      </div>
    </div>
    <span class="col-start-2 font-mono text-[11px] text-muted-foreground md:col-start-3 md:text-right">
      {formatDate(date)} · {minutes} min
    </span>
  </a>
</li>
