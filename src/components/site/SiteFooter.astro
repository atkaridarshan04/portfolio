---
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-3 px-6 py-10 sm:flex-row sm:items-center">
    <div class="flex items-center gap-2.5">
      <span class="grid h-6 w-6 place-items-center rounded-[3px] bg-primary font-display text-[13px] font-medium leading-none text-primary-foreground">DA</span>
      <span class="label-mono text-muted-foreground">Darshan Atkari · © {year}</span>
    </div>
    <div class="flex items-center gap-5">
      <a href="/rss.xml" class="label-mono text-muted-foreground/60 transition-state hover:text-primary">RSS</a>
      <span class="label-mono text-muted-foreground/60">Designed &amp; engineered with intent.</span>
    </div>
  </div>
</footer>
