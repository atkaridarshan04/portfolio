---
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import PostRow from "@/components/site/PostRow.astro";
import { countTags, getPublishedPosts } from "@/lib/posts";

const posts = await getPublishedPosts();
const tags = countTags(posts);
/* the filter row shows the tags that split the list: on two or more notes,
   and not on nearly all of them (a tag on three quarters of the notes is
   a category, not a filter). The rest sit behind "more". */
const splits = (t: { count: number }) => t.count >= 2 && t.count / posts.length < 0.75;
const primary = tags.filter(splits);
const more = tags.filter((t) => !splits(t));
---

<Base
  title="Field notes | Darshan Atkari"
  description="Short write-ups of things that broke or needed deciding on Kubernetes, AWS, GitOps and MLOps systems, each tied to the repository it came from."
  path="/writing/"
  image="/writing/og.png"
  imageAlt="Field notes by Darshan Atkari"
  transitions
>
  <SiteHeader current="writing" />
  <main class="relative min-h-screen bg-background text-foreground antialiased">
    <section class="section-pad pt-32 sm:pt-36">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:items-end">
          <div class="md:col-span-7">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center gap-1.5 label-mono text-status-good">
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-status-good status-pulse"></span>
                published
              </span>
              <div class="h-px w-8 bg-hairline"></div>
              <span class="label-mono text-muted-foreground">component / writing</span>
            </div>
            <h1 class="mt-7 font-display display-section text-balance">
              Field notes.<br />
              <span class="text-muted-foreground">Incidents, decisions, fixes.</span>
            </h1>
          </div>
          <p class="max-w-md text-[15px] leading-relaxed text-muted-foreground md:col-span-5">
            Short write-ups of things that broke or needed deciding, each tied to the repository it came from. The
            mechanism first, then what was done about it.
          </p>
        </div>

        <div class="mt-12 flex flex-wrap items-center gap-x-3 gap-y-2" data-filter>
          <span class="mr-1 label-mono text-muted-foreground/60">filter</span>
          <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter notes by tag">
            <button type="button" class="chip" data-tag="" aria-pressed="true">All <span class="text-muted-foreground/50">{posts.length}</span></button>
            {primary.map((t) => (
              <button type="button" class="chip" data-tag={t.slug} aria-pressed="false">
                {t.tag} <span class="text-muted-foreground/50">{t.count}</span>
              </button>
            ))}
            {more.length > 0 && (
              <button type="button" class="chip" data-more aria-expanded="false" aria-controls="filter-more">+ {more.length} more</button>
            )}
          </div>
          {more.length > 0 && (
            <div id="filter-more" class="flex w-full flex-wrap gap-1.5" hidden>
              {more.map((t) => (
                <button type="button" class="chip" data-tag={t.slug} aria-pressed="false">
                  {t.tag} <span class="text-muted-foreground/50">{t.count}</span>
                </button>
              ))}
            </div>
          )}
        </div>

        <p class="mt-6 font-mono text-[11px] text-muted-foreground/60" data-filter-status aria-live="polite">
          {posts.length} notes
        </p>

        <ul class="post-list mt-3 border-t border-hairline">
          {posts.map((post, i) => <PostRow post={post} index={i} />)}
        </ul>

        <div class="mt-16 flex flex-wrap items-baseline justify-between gap-4 border-t border-hairline pt-6">
          <p class="max-w-md text-sm text-muted-foreground">
            New notes land here first and are posted to LinkedIn after. Subscribe and skip the feed.
          </p>
          <a href="/rss.xml" class="group inline-flex items-center gap-2 font-mono text-sm text-foreground transition-state hover:text-primary">
            rss.xml <span aria-hidden class="inline-block translate-y-px opacity-60 group-hover:opacity-100">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <script>
    /* in-place filtering: one tag at a time, rows hidden rather than
       re-rendered, the choice kept in the hash so a filtered view can be
       shared or come back after a client-side navigation */
    function initFilter() {
      const box = document.querySelector<HTMLElement>("[data-filter]");
      const list = document.querySelector<HTMLElement>(".post-list");
      const status = document.querySelector<HTMLElement>("[data-filter-status]");
      if (!box || !list || !status) return;
      const chips = [...box.querySelectorAll<HTMLButtonElement>("button[data-tag]")];
      const rows = [...list.querySelectorAll<HTMLLIElement>("li[data-tags]")];
      const more = box.querySelector<HTMLButtonElement>("button[data-more]");
      const panel = document.getElementById("filter-more");

      const apply = (tag: string, push = true) => {
        let shown = 0;
        for (const row of rows) {
          const on = !tag || (row.dataset.tags ?? "").split(" ").includes(tag);
          row.hidden = !on;
          if (on) shown += 1;
        }
        for (const chip of chips) chip.setAttribute("aria-pressed", String((chip.dataset.tag ?? "") === tag));
        const label = tag ? chips.find((c) => c.dataset.tag === tag)?.firstChild?.textContent?.trim() : "";
        status.textContent = tag ? `${shown} of ${rows.length} notes · ${label}` : `${rows.length} notes`;
        if (tag && panel && panel.hidden && panel.querySelector(`[data-tag="${tag}"]`)) {
          panel.hidden = false;
          more?.setAttribute("aria-expanded", "true");
        }
        if (push) history.replaceState(null, "", tag ? `#${tag}` : location.pathname);
      };

      for (const chip of chips) {
        chip.addEventListener("click", () => {
          const tag = chip.dataset.tag ?? "";
          apply(chip.getAttribute("aria-pressed") === "true" && tag ? "" : tag);
        });
      }
      more?.addEventListener("click", () => {
        if (!panel) return;
        panel.hidden = !panel.hidden;
        more.setAttribute("aria-expanded", String(!panel.hidden));
      });

      const initial = decodeURIComponent(location.hash.slice(1));
      if (initial && chips.some((c) => c.dataset.tag === initial)) apply(initial, false);
    }
    document.addEventListener("astro:page-load", initFilter);
  </script>
</Base>
