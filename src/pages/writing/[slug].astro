---
import { render } from "astro:content";
import Base from "@/layouts/Base.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import { formatDate, getPublishedPosts, readingTime, tagSlug } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, deck, description, date, updated, tags, repo, linkedin, draft } = post.data;
const minutes = readingTime(post.body);
const path = `/writing/${post.id}/`;
const fullTitle = deck ? `${title} — ${deck}` : title;

const article = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: fullTitle,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  keywords: tags.join(", "),
  url: new URL(path, Astro.site).href,
  author: { "@type": "Person", name: "Darshan Atkari", url: "https://atkaridarshan.online/" },
};
---

<Base title={`${fullTitle} | Darshan Atkari`} description={description} path={path} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
  </Fragment>

  <SiteHeader current="writing" />
  <main class="relative min-h-screen bg-background text-foreground antialiased">
    <article class="section-pad pt-32 sm:pt-36">
      <div class="mx-auto max-w-3xl px-6">
        <a href="/writing/" class="group inline-flex items-center gap-2 font-mono text-[12px] text-muted-foreground transition-state hover:text-primary">
          <span aria-hidden>←</span> all field notes
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="label-mono text-muted-foreground">component / writing</span>
          <div class="h-px w-8 bg-hairline"></div>
          <span class="font-mono text-[11px] text-muted-foreground">
            {formatDate(date)} · {minutes} min read
          </span>
          {draft && <span class="chip">draft</span>}
        </div>

        <h1 class="mt-6 font-display display-section text-balance">{title}</h1>
        {deck && <p class="mt-4 text-[clamp(1.05rem,1.8vw,1.25rem)] leading-snug text-muted-foreground">{deck}</p>}

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-y border-hairline py-4">
          <div class="flex flex-wrap gap-1.5">
            {tags.map((t) => <a href={`/writing/tags/${tagSlug(t)}/`} class="chip">{t}</a>)}
          </div>
          <div class="ml-auto flex flex-wrap items-center gap-5">
            {repo && (
              <a href={repo} target="_blank" rel="noreferrer" class="group inline-flex items-center gap-1.5 font-mono text-[12px] text-foreground transition-state hover:text-primary">
                source <span aria-hidden class="inline-block translate-y-px opacity-60 group-hover:opacity-100">↗</span>
              </a>
            )}
            {linkedin && (
              <a href={linkedin} target="_blank" rel="noreferrer" class="group inline-flex items-center gap-1.5 font-mono text-[12px] text-foreground transition-state hover:text-primary">
                discussion <span aria-hidden class="inline-block translate-y-px opacity-60 group-hover:opacity-100">↗</span>
              </a>
            )}
          </div>
        </div>

        <div class="post-body mt-10">
          <Content />
        </div>

        {updated && (
          <p class="mt-10 font-mono text-[11px] text-muted-foreground/60">updated {formatDate(updated)}</p>
        )}

        <nav class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-hairline bg-hairline sm:grid-cols-2" aria-label="Adjacent notes">
          {older ? (
            <a href={`/writing/${older.id}/`} class="group bg-background p-5 transition-state hover:bg-surface/60">
              <span class="label-mono text-muted-foreground/60">← older</span>
              <span class="mt-2 block heading-sans text-[15px] leading-snug text-foreground transition-state group-hover:text-primary">{older.data.title}</span>
            </a>
          ) : (
            <span class="bg-background p-5"></span>
          )}
          {newer ? (
            <a href={`/writing/${newer.id}/`} class="group bg-background p-5 transition-state hover:bg-surface/60 sm:text-right">
              <span class="label-mono text-muted-foreground/60">newer →</span>
              <span class="mt-2 block heading-sans text-[15px] leading-snug text-foreground transition-state group-hover:text-primary">{newer.data.title}</span>
            </a>
          ) : (
            <span class="bg-background p-5"></span>
          )}
        </nav>
      </div>
    </article>
  </main>
  <SiteFooter />
</Base>
